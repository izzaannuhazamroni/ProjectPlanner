# ============================================================
# Konfigurasi Server - salin file ini menjadi ".env" lalu isi
#   cp .env.example .env
# JANGAN pernah commit file .env ke Git.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# Origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu).
# Lokal : http://localhost:5173
# Produksi: https://nama-app-anda.vercel.app
CLIENT_URL=http://localhost:5173

# --- Supabase ---
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Gunakan "service_role" key (RAHASIA, hanya untuk backend, jangan taruh di frontend!)
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key

# --- WhatsApp Gateway ---
# Pilihan: baileys | fonnte | none
#   baileys : gratis, scan QR dari UI (sesi disimpan di Supabase)
#   fonnte  : layanan API free-tier, butuh FONNTE_TOKEN
#   none    : nonaktifkan pengiriman (mode uji coba UI saja)
WA_PROVIDER=baileys

# Hanya dipakai bila WA_PROVIDER=fonnte
FONNTE_TOKEN=

# Nama sesi autentikasi Baileys (boleh dibiarkan default)
WA_AUTH_SESSION=default

# Jeda antar pesan saat cron mengirim banyak pesan (ms) - mengurangi risiko diblokir
WA_SEND_DELAY_MS=4000

# --- Cron Job Pengingat ---
CRON_ENABLED=true
# Default: setiap jam pada menit ke-0
CRON_SCHEDULE=0 * * * *
# Zona waktu untuk cron & format tanggal di pesan WhatsApp
APP_TIMEZONE=Asia/Jakarta
# Pengingat "H-1": kirim bila deadline berada dalam X jam ke depan
REMINDER_WINDOW_HOURS=24

# Secret opsional untuk memicu cron dari luar (mis. cron-job.org / UptimeRobot):
#   POST /api/cron/run  dengan header  x-cron-secret: <nilai ini>
# Kosongkan untuk menonaktifkan endpoint tersebut.
CRON_SECRET=
