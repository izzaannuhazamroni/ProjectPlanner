# Salin menjadi ".env" (lokal) atau isi di Vercel -> Settings -> Environment Variables.
# Variabel Vite WAJIB berawalan VITE_ dan akan terlihat publik di browser,
# jadi JANGAN taruh rahasia apa pun di sini.

# URL backend (sertakan /api di akhir)
# Lokal    : http://localhost:5000/api
# Produksi : https://nama-backend-anda.onrender.com/api
VITE_API_URL=http://localhost:5000/api
